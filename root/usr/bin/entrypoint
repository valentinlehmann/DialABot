#!/bin/sh
set -e

mkdir -p /run/dbus /config/ts3client
rm -f /run/dbus/pid /run/pulse/pid /var/run/pulse/.config/pulse/cookie /tmp/.X99-lock /tmp/.X11-unix/X99

dbus-daemon --system --print-address --fork

pulseaudio --exit-idle-time=-1 --disallow-exit=yes --system --daemonize --disallow-module-loading -n --file=/etc/pulse/system.pa

# Start Xvfb for TeamSpeak
touch /root/.Xauthority
Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp -auth /root/.Xauthority &

export PJSUA_LOG_FILE=/tmp/pjsua.log
rm -f "$PJSUA_LOG_FILE"

# Start pjsua exactly as in the working config
pjsua --realm="*" --auto-answer 200 --no-cli-console --use-cli --config-file /config/pjsua.cfg \
    --log-level 5 --app-log-level 3 --log-file "$PJSUA_LOG_FILE" --log-append &

# Monitor for active calls and connect/disconnect the always-running TeamSpeak client accordingly
exec /usr/bin/call-monitor
